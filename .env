# =====================================================================
# A2EMoney — PUBLIC, non-secret configuration only.
# All secrets (WorkOS keys, Convex deploy key) live in .env.local (gitignored).
# Auth is handled by WorkOS AuthKit. The legacy Convex-Auth (Google/Resend)
# variables have been removed — they are no longer used.
# =====================================================================

# Convex deployment URL (public — used by the browser client).
NEXT_PUBLIC_CONVEX_URL=https://academic-stoat-784.eu-west-1.convex.cloud
CONVEX_URL=https://academic-stoat-784.eu-west-1.convex.cloud

# Public site URL (override per environment in .env.local).
NEXT_PUBLIC_SITE_URL=https://a2e.app

# ---------------------------------------------------------------------
# Required secrets to set in .env.local (NEVER commit):
#   WORKOS_CLIENT_ID, WORKOS_API_KEY, WORKOS_COOKIE_PASSWORD,
#   WORKOS_REDIRECT_URI, NEXT_PUBLIC_WORKOS_REDIRECT_URI, CONVEX_DEPLOY_KEY
# WorkOS also needs WORKOS_CLIENT_ID + WORKOS_API_KEY set on the Convex
# deployment (npx convex env set ...).
# ---------------------------------------------------------------------

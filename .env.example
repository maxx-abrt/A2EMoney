# AWS S3 storage (required for document uploads)
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Optional: S3-compatible service (Scaleway, MinIO, Wasabi, ...)
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_FORCE_PATH_STYLE=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Convex Auth
AUTH_SECRET=                          # openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=                      # from https://resend.com/api-keys
AUTH_RESEND_FROM=A2E Money <auth@association2e.org>

# PostgreSQL (Neon, Supabase, or any Postgres)
DATABASE_URL=postgresql://user:password@host:5432/finflow
